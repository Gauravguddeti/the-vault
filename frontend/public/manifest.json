{
  "name": "The Vault",
  "short_name": "Vault",
  "description": "Your personal document archive. Receipts, invoices, and more — securely stored and instantly searchable.",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#0d0d0f",
  "theme_color": "#c20114",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/jpeg", "image/png", "image/webp", "image/tiff"]
        }
      ]
    }
  }
}
